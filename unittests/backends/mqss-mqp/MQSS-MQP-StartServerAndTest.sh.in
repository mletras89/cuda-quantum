# Launch the fake server
PYTHONPATH=@CMAKE_BINARY_DIR@/python @Python_EXECUTABLE@ @CMAKE_SOURCE_DIR@/utils/mock_qpu/mqss_mqp/__init__.py &
SERVER_PID=$!
sleep 2

# Run the tests
@CMAKE_CURRENT_BINARY_DIR@/test-mqp-mqss
TEST_STATUS=$?

# Kill the server
kill $SERVER_PID

# Return the test status
exit $TEST_STATUS
